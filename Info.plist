<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Partial Info.plist, merged with the generated one (GENERATE_INFOPLIST_FILE stays
	  YES; INFOPLIST_FILE points here). Kept OUTSIDE the synchronized notchboard/ folder
	  on purpose: inside it, the build both generates and copies an Info.plist and fails
	  with "multiple commands produce" - the exact collision NotchDemo hit (vision.md
	  section 13.6). Array-valued keys like CFBundleDocumentTypes cannot be expressed as
	  INFOPLIST_KEY_ build settings, which is why this file exists at all.

	  ".notchboard" is the extension - deliberately single-dot, because LaunchServices
	  resolves multi-dot extensions by their last component and could never associate a
	  ".something.json" spelling with anything but a JSON handler.
	-->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Notchboard Collection</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.flourix.notchboard.collection</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.flourix.notchboard.collection</string>
			<key>UTTypeDescription</key>
			<string>Notchboard Collection</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>notchboard</string>
				</array>
			</dict>
		</dict>
	</array>
	<!--
	  Sparkle (in-app updates, vision.md section 13.20). These are Sparkle's keys, not Apple's,
	  so INFOPLIST_KEY_ build settings cannot carry them; they live here with the other keys
	  the generated Info.plist cannot express.

	  SUFeedURL is GitHub's "latest release" redirector, so the feed is always the appcast
	  attached to the newest release and never a cached copy. SUPublicEDKey is the public half
	  of the key that signs every update archive (the private half is in the maintainer's login
	  keychain, and belongs in the SPARKLE_PRIVATE_KEY repository secret before the first tag). SUEnableAutomaticChecks is the
	  default for the Settings toggle: Sparkle keeps the user's answer in its own defaults
	  (flourix.notchboard.plist), and nothing in state.json mirrors it. SUAllowsAutomaticUpdates
	  is off so Sparkle never offers to download and install on its own: the user chooses when.
	-->
	<key>SUFeedURL</key>
	<string>https://github.com/thepearl/notchboard/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>b5CLyrYINTcYNacCKL3Pd6HqBOjsiq2iY8dMCRMAfTc=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAllowsAutomaticUpdates</key>
	<false/>
</dict>
</plist>
